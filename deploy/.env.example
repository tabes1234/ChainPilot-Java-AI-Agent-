# ChainPilot public deployment template. Copy to deploy/.env and fill in locally.
# NEVER commit deploy/.env. No real secret values are stored in this repository.

# ── Self-hosted compose (MySQL) ──────────────────────────────────────────────
# Required by deploy/docker-compose.public.yml. Generate a long random value.
MYSQL_ROOT_PASSWORD=

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Backend origin used by the /api and /uploads rewrites. For the all-in-one image
# keep http://127.0.0.1:8065 (build-time). For split deploys use the backend HTTPS URL.
CHAINPILOT_BACKEND_URL=http://127.0.0.1:8065
# demo mode: closes write-heavy configuration pages in navigation.
NEXT_PUBLIC_CHAINPILOT_DEMO_MODE=true
# public demo hardening: blocks admin/config APIs and pages via middleware (build-time).
CHAINPILOT_PUBLIC_DEMO=true

# ── Backend (Spring Boot) ───────────────────────────────────────────────────
# h2 (default, file DB) or mysql.
SPRING_PROFILES_ACTIVE=h2
# MySQL only (SPRING_PROFILES_ACTIVE=mysql):
DATA_AGENT_DATASOURCE_URL=
DATA_AGENT_DATASOURCE_USERNAME=
DATA_AGENT_DATASOURCE_PASSWORD=
# always = run schema.sql + data.sql seed on startup (demo only; idempotent DDL).
DATA_AGENT_DATASOURCE_SQL_INIT=always
# H2 only (defaults are fine for demo):
# CHAINPILOT_H2_USERNAME=sa
# CHAINPILOT_H2_PASSWORD=

# ── Model access (optional, server-side only) ───────────────────────────────
# Leave empty for the deterministic fallback demo. Never expose these to the browser.
# AI_DASHSCOPE_API_KEY=
