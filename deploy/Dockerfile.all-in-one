# ChainPilot all-in-one image: Next.js + Spring Boot (H2 profile) for a free single-service demo.
# Build context: repository root.
#   docker build -f deploy/Dockerfile.all-in-one -t chainpilot-demo .
# The backend binds to 127.0.0.1 inside the container; only the Next.js proxy (port 3000)
# is reachable, so admin APIs are additionally gated by CHAINPILOT_PUBLIC_DEMO middleware.
FROM maven:3.9-eclipse-temurin-17 AS backend
WORKDIR /build
COPY pom.xml ./
COPY data-agent-management/pom.xml data-agent-management/
RUN mvn -q -pl data-agent-management -am dependency:go-offline -DskipTests || true
COPY data-agent-management/src data-agent-management/src
RUN mvn -q -pl data-agent-management -am package -DskipTests -Djacoco.skip=true

FROM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY data-agent-frontend-next/package.json data-agent-frontend-next/package-lock.json ./
RUN npm ci
COPY data-agent-frontend-next/ ./
ENV CHAINPILOT_BACKEND_URL=http://127.0.0.1:8065 \
    CHAINPILOT_PUBLIC_DEMO=true \
    NEXT_PUBLIC_CHAINPILOT_DEMO_MODE=true \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor \
    && rm -rf /var/lib/apt/lists/*

COPY --from=eclipse-temurin:17-jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    SPRING_PROFILES_ACTIVE=h2 \
    TZ=Asia/Shanghai

COPY --from=backend /build/data-agent-management/target/chainpilot-management-1.0.0-SNAPSHOT.jar /app/backend/app.jar
COPY --from=frontend /app/package.json /app/frontend/package.json
COPY --from=frontend /app/node_modules /app/frontend/node_modules
COPY --from=frontend /app/.next /app/frontend/.next
COPY --from=frontend /app/public /app/frontend/public
COPY --from=frontend /app/next.config.ts /app/frontend/next.config.ts
COPY deploy/supervisord.conf /etc/supervisor/conf.d/chainpilot.conf

RUN mkdir -p /app/data /var/log/supervisor

EXPOSE 3000

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/chainpilot.conf"]
